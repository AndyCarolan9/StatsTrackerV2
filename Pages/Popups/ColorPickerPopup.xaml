<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup 
    x:Class="StatsTrackerV2.Pages.Popups.ColorPickerPopup" 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" 
    xmlns:local="clr-namespace:StatsTrackerV2.Pages.Controls">
    <Border Padding="12" BackgroundColor="{AppThemeBinding Light=White, Dark=#292929}" Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#555555}" StrokeThickness="1">
        <VerticalStackLayout Spacing="10" WidthRequest="350">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Colour" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="✕" FontSize="16" Padding="8,2" Clicked="Close_Clicked" />
            </Grid>
            <!-- Picker -->
            <local:ColorPicker x:Name="PickerControl" />
            <!-- Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="Cancel" Clicked="Cancel_Clicked" />
                <Button Grid.Column="1" Text="OK" Clicked="OK_Clicked" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
