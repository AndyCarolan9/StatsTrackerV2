<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:StatsTrackerV2.PageModels"
             xmlns:controls="clr-namespace:StatsTrackerV2.Pages.Controls"
             x:DataType="pageModels:TacticBoardPageModel"
             x:Class="StatsTrackerV2.Pages.TacticBoardPage"
             Title="TacticBoardPage">

    <Grid ColumnDefinitions="*, Auto">
        <controls:TacticalBoard Grid.Column="0" TacticalPlayers="{Binding TacticalPlayers}"/>
        <Border Grid.Column="1">
            <Button Text="Starting Layout" Command="{Binding PopulateStartingLayoutCommand}"/>
        </Border>
    </Grid>
    
</ContentPage>