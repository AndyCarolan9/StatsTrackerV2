<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StatsTrackerV2.Pages.Controls.PitchDisplay">
    <Grid ColumnDefinitions="50, *, 50">
        <Image x:Name="MainImage" Grid.Column="1"
               Source="inputfieldhorizontalnewrules.png"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>

        <GraphicsView x:Name="drawingView" Grid.Column="1"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"/>

        <AbsoluteLayout Grid.Column="0">
            <Label x:Name="homeTeamLabel"
                   FontAttributes="Bold"
                   FontSize="Large" Rotation="-90"
                   AbsoluteLayout.LayoutBounds="0.5,0.5,-1,-1"
                   AbsoluteLayout.LayoutFlags="PositionProportional"/>
        </AbsoluteLayout>

        <AbsoluteLayout Grid.Column="2">
            <Label x:Name="awayTeamLabel" Grid.Column="2"
               FontAttributes="Bold"
               FontSize="Large" Rotation="90"
               AbsoluteLayout.LayoutBounds="0.5,0.5,-1,-1"
               AbsoluteLayout.LayoutFlags="PositionProportional"/>
        </AbsoluteLayout>
    </Grid>
</ContentView>
