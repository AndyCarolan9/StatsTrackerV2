<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StatsTrackerV2.Model.EventScores"
             x:Class="StatsTrackerV2.Pages.Controls.DataGrid">
    <CollectionView x:Name="dataGrid">
        <CollectionView.Header>
            <Grid ColumnDefinitions="150,100,100">
                <Border Stroke="Black"
                        StrokeThickness="3"
                        StrokeShape="Rectangle"
                        Padding="10"
                        WidthRequest="150"
                        Grid.Column="0">
                    <Label Text="Type" FontAttributes="Bold"/>
                </Border>

                <Border Stroke="Black"
                        StrokeThickness="3"
                        StrokeShape="Rectangle"
                        Padding="10"
                        WidthRequest="100"
                        Grid.Column="1">
                    <Label Text="1st Half" Grid.Column="1" FontAttributes="Bold"/>
                </Border>

                <Border Stroke="Black"
                        StrokeThickness="3"
                        StrokeShape="Rectangle"
                        Padding="10"
                        WidthRequest="100"
                        Grid.Column="2">
                    <Label Text="2nd Half" Grid.Column="2" FontAttributes="Bold"/>
                </Border>
            </Grid>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:EventScore">
                <Grid ColumnDefinitions="150,100,100">
                    <Border Stroke="Black"
                            StrokeThickness="3"
                            StrokeShape="Rectangle"
                            Padding="10"
                            WidthRequest="150">
                        <Label Text="{Binding Title}" />
                    </Border>

                    <Border Stroke="Black"
                            StrokeThickness="3"
                            StrokeShape="Rectangle"
                            Padding="10"
                            WidthRequest="100"
                            Grid.Column="1">
                        <Label Text="{Binding FirstHalfValue}" />
                    </Border>

                    <Border Stroke="Black"
                            StrokeThickness="3"
                            StrokeShape="Rectangle"
                            Padding="10"
                            WidthRequest="100"
                            Grid.Column="2">
                        <Label Text="{Binding SecondHalfValue}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
