<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StatsTrackerV2.Models"
             x:Class="StatsTrackerV2.Pages.Controls.PlayerScoreDataGrid">
    <CollectionView x:Name="dataGrid">
        <CollectionView.Header>
            <Grid ColumnDefinitions="150,100,150">
                <Border Stroke="Black"
                    StrokeThickness="3"
                    StrokeShape="Rectangle"
                    Padding="10"
                    WidthRequest="150"
                    Grid.Column="0">
                    <Label x:Name="column1" Text="Player" FontAttributes="Bold"/>
                </Border>

                <Border Stroke="Black"
                    StrokeThickness="3"
                    StrokeShape="Rectangle"
                    Padding="10"
                    WidthRequest="100"
                    Grid.Column="1">
                    <Label x:Name="column2" Text="Score" Grid.Column="1" FontAttributes="Bold"/>
                </Border>

                <Border Stroke="Black"
                    StrokeThickness="3"
                    StrokeShape="Rectangle"
                    Padding="10"
                    WidthRequest="150"
                    Grid.Column="2">
                    <Label x:Name="column3" Text="Scored/Total (%)" Grid.Column="2" FontAttributes="Bold"/>
                </Border>
            </Grid>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:PlayerScore">
                <Grid ColumnDefinitions="150,100,150">
                    <Border Stroke="Black"
                        StrokeThickness="3"
                        StrokeShape="Rectangle"
                        Padding="10"
                        WidthRequest="150">
                        <Label Text="{Binding PlayerName}" />
                    </Border>

                    <Border Stroke="Black"
                        StrokeThickness="3"
                        StrokeShape="Rectangle"
                        Padding="10"
                        WidthRequest="100"
                        Grid.Column="1">
                        <Label Text="{Binding Score}" />
                    </Border>

                    <Border Stroke="Black"
                        StrokeThickness="3"
                        StrokeShape="Rectangle"
                        Padding="10"
                        WidthRequest="150"
                        Grid.Column="2">
                        <Label Text="{Binding ShootingPercentage}" />
                    </Border>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentView>
