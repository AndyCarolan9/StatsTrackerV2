<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:StatsTrackerV2.Models.ResultColors"
             x:Class="StatsTrackerV2.Pages.Controls.LocationMapLegend">
    <VerticalStackLayout Spacing="5">
        <Label 
            Text="Legend"
            VerticalOptions="Center" 
            HorizontalOptions="Center" FontSize="Medium" />

        <HorizontalStackLayout>
            <Ellipse Fill="White" Stroke="Black" StrokeThickness="5" WidthRequest="20" HeightRequest="20" HorizontalOptions="Start" VerticalOptions="Center"/>
            <Label Text="First Half" Margin="10,0,0,0"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout>
            <Rectangle Fill="White" Stroke="Black" StrokeThickness="5" WidthRequest="18" HeightRequest="18" HorizontalOptions="Start" VerticalOptions="Center"/>
            <Label Text="Second Half" Margin="10,0,0,0"/>
        </HorizontalStackLayout>

        <CollectionView x:Name="legendList">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="5"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EventResultColor">
                    <HorizontalStackLayout>
                        <Rectangle Fill="{Binding Color}" StrokeThickness="5" WidthRequest="18" HeightRequest="18" HorizontalOptions="Start" VerticalOptions="Center"/>
                        <Label Text="{Binding Name}" Margin="10,0,0,0"/>
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
