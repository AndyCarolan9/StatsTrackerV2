<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    x:Class="StatsTrackerV2.Pages.Controls.ColorPickerButton" 
    x:Name="Root" 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border Padding="3" 
            Stroke="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" 
            StrokeThickness="1" 
            StrokeShape="RoundRectangle 6">
        <Button 
            x:Name="ColourButton" 
            Padding="0" 
            BackgroundColor="{Binding SelectedColor, Source={x:Reference Root}}" 
            Clicked="ColourButton_Clicked" />
    </Border>
</ContentView>
